# Copy to .env, fill in your tracker details, then load as described in README.md.
TRACKER_IMEI=REPLACE_WITH_15_DIGIT_IMEI
DOG_NAME="My dog"
# Choose a long, random access token. Do not use the tracker's SMS password here.
DOGTRACK_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
WEB_HOST=0.0.0.0
WEB_PORT=8080
TRACKER_PORT=7700
